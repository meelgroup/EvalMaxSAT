# Config file for the Build-tree EvalMaxSAT package (not relocatable).
set(EVALMAXSAT_INCLUDE_DIRS "@CMAKE_CURRENT_BINARY_DIR@/include")
include("${CMAKE_CURRENT_LIST_DIR}/EvalMaxSATTargets.cmake")
set(EVALMAXSAT_LIBRARIES EvalMaxSAT)
set(EVALMAXSAT_STATIC_LIBRARIES EvalMaxSAT)
set(EVALMAXSAT_LIBRARIES_DEPS evalmax_cadical)
set(EVALMAXSAT_VERSION_MAJOR @EVALMAXSAT_VERSION_MAJOR@)
set(EVALMAXSAT_VERSION_MINOR @EVALMAXSAT_VERSION_MINOR@)
set(EVALMAXSAT_VERSION_PATCH @EVALMAXSAT_VERSION_PATCH@)
set(EVALMAXSAT_VERSION @EVALMAXSAT_VERSION@)
set(EVALMAXSAT_EXECUTABLE EvalMaxSAT_bin)
